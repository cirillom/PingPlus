<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.2.0</Version>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*"><PrivateAssets>all</PrivateAssets><IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets></PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="*-*" />
    <PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="RoR2BepInExPack" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/scrap.png" LogicalName="PingPlus.Assets.scrap.png" />
  </ItemGroup>
  <PropertyGroup><ReleaseRoot>$(MSBuildProjectDirectory)/../../dist</ReleaseRoot></PropertyGroup>
  <Target Name="PrepareModRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(ReleaseRoot)" />
    <MakeDir Directories="$(ReleaseRoot)/BepInEx/plugins/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseRoot)/BepInEx/plugins/$(AssemblyName)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../manifest.json;$(MSBuildProjectDirectory)/../../README.md;$(MSBuildProjectDirectory)/../../CHANGELOG.md;$(MSBuildProjectDirectory)/../../icon.png;$(MSBuildProjectDirectory)/../../example.png" DestinationFolder="$(ReleaseRoot)" />
  </Target>
</Project>
